# Required
OPENAI_API_KEY=sk-proj-...
DATABASE_URL=postgresql://user:password@host:5432/nutrition_db

# Optional
MISTRAL_API_KEY=
USDA_API_KEY=DEMO_KEY
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0
SESSION_MAX_HOURS=8

# Abuse protection
CHAT_RATE_LIMIT_PER_MINUTE=20
AGENT_CACHE_MAX=256

# Supermarket offers — set to 1 to refresh the offers cache on container startup
RUN_OFFERS_INGEST=0

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json

# LangSmith tracing (optional — leave disabled if you have no key)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nutribot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
